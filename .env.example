# Copy to .env (same folder as prozorro_publisher.py) and fill in. Never commit .env.
# Telegram: create a bot with @BotFather -> token. Your numeric user id: message @userinfobot.
TG_BOT_TOKEN=
TG_ADMIN_IDS=            # comma-separated user ids allowed to approve, e.g. 123456789
TG_REVIEW_CHAT_ID=       # where drafts arrive; usually your own user id
TG_CHANNEL_ID=           # optional: @your_channel (bot must be channel admin) to mirror published posts

# X: developer.x.com -> Project/App -> User authentication settings: Read and write.
# Keys and tokens tab -> API Key and Secret + Access Token and Secret (generated for the bot account).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
