# Для локального запуску аналітики (python -m prozorro.pipeline ...). Скопіюйте у .env і заповніть. Ніколи не комітьте .env.
# У GitHub Actions ці значення беруться із секретів репозиторію.
TG_BOT_TOKEN=            # токен бота від @BotFather; з нього виводиться ключ API Worker
WORKER_URL=              # необов'язково: адреса Worker, якщо немає worker/url.txt
