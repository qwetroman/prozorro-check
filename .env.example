# Скопіюйте у .env (у ту саму теку, що й prozorro_publisher.py) і заповніть. Ніколи не комітьте .env.
# Telegram: створіть бота через @BotFather -> токен. Ваш числовий id: напишіть @userinfobot.
TG_BOT_TOKEN=
TG_ADMIN_IDS=            # id користувачів через кому, яким дозволено схвалювати, напр. 123456789
TG_REVIEW_CHAT_ID=       # куди надходять чернетки; зазвичай ваш власний id
TG_CHANNEL_ID=           # необов'язково: @your_channel (бот має бути адміністратором каналу), щоб дублювати опубліковані дописи

# X (необов'язково; без ключів ви отримуватимете в Telegram посилання для публікації одним дотиком):
# developer.x.com -> Project/App -> User authentication settings: Read and write.
# Вкладка Keys and tokens -> API Key and Secret + Access Token and Secret (згенеровані для акаунта бота).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
